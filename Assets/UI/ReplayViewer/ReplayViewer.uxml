<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ReplayViewer.uss" />
    <ui:VisualElement name="root" class="rv-root" picking-mode="Ignore">
        <ui:VisualElement name="kb-tags" class="rv-name-tags" picking-mode="Ignore" />
        <ui:VisualElement name="name-tags" class="rv-name-tags" picking-mode="Ignore" />

        <ui:VisualElement class="rv-top" picking-mode="Ignore">
            <ui:VisualElement class="rv-top-side rv-top-side--left" picking-mode="Ignore">
                <ui:VisualElement class="rv-title-row" picking-mode="Ignore">
                    <ui:Button name="back-button" text="LIBRARY" class="rv-button" />
                    <ui:Label name="map-label" class="rv-map" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="rv-modes">
                    <ui:Button name="mode-watch" text="WATCH" class="rv-mode" tooltip="Watch the recording. Click a player to follow them." />
                    <ui:Button name="mode-intel" text="INTEL" class="rv-mode" tooltip="What one team knows: last seen positions, sounds, utility (B)." />
                    <ui:Button name="mode-command" text="COMMAND" class="rv-mode" tooltip="The AI plays the round from here and takes your orders (C)." />
                    <ui:Button name="mode-play" text="PLAY AS..." class="rv-mode" tooltip="Take over a player from this moment in first person (Enter on the followed player)." />
                </ui:VisualElement>
                <ui:VisualElement name="mode-options" class="rv-mode-options">
                    <ui:Button name="kb-team-button" text="INTEL OFF" class="rv-button rv-button--small rv-kb-button" />
                    <ui:Button name="kb-truth-button" text="HIDE ENEMIES" class="rv-button rv-button--small rv-kb-button" />
                </ui:VisualElement>
                <ui:Label name="mode-hint" class="rv-mode-hint" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="rv-scoreboard">
                <ui:Label name="team0-role" class="rv-role rv-team0-text" />
                <ui:Label name="team0-score" text="0" class="rv-score rv-team0-text" />
                <ui:VisualElement class="rv-clock">
                    <ui:Label name="round-label" text="ROUND –" class="rv-round" />
                    <ui:Label name="timer-label" text="–:––" class="rv-timer" />
                    <ui:Label name="phase-label" class="rv-phase" />
                </ui:VisualElement>
                <ui:Label name="team1-score" text="0" class="rv-score rv-team1-text" />
                <ui:Label name="team1-role" class="rv-role rv-team1-text" />
            </ui:VisualElement>
            <ui:VisualElement class="rv-top-side rv-top-side--right" picking-mode="Ignore">
                <ui:VisualElement name="killfeed" class="rv-killfeed" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="rv-middle" picking-mode="Ignore">
            <ui:VisualElement name="team0-list" class="rv-team-list" />
            <ui:VisualElement class="rv-grow rv-center" picking-mode="Ignore">
                <ui:Label name="message" class="rv-message" />
                <ui:VisualElement name="knowledge" class="rv-kb">
                    <ui:VisualElement class="rv-kb-header">
                        <ui:Label name="kb-title" class="rv-kb-title" />
                        <ui:Label name="kb-status" class="rv-kb-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="kb-rows" />
                    <ui:Label name="kb-summary" class="rv-kb-summary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="team1-list" class="rv-team-list" />
        </ui:VisualElement>

        <ui:VisualElement class="rv-bottom">
            <ui:VisualElement class="rv-transport">
                <ui:Button name="prev-round" text="PREV" class="rv-button rv-button--small" />
                <ui:Button name="back-5" text="-5s" class="rv-button rv-button--small" />
                <ui:Button name="play-button" text="PAUSE" class="rv-button rv-button--play" />
                <ui:Button name="fwd-5" text="+5s" class="rv-button rv-button--small" />
                <ui:Button name="next-round" text="NEXT" class="rv-button rv-button--small" />
                <ui:Label name="time-label" text="0:00 / 0:00" class="rv-time" />
                <ui:VisualElement name="speed-group" class="rv-speeds" />
                <ui:Label name="follow-label" class="rv-follow rv-grow" />
                <ui:VisualElement class="rv-tools">
                    <ui:Button name="tool-map" text="3D MAP" class="rv-tool" tooltip="3D map or minimap (M)" />
                    <ui:Button name="tool-tags" text="NAMES" class="rv-tool" tooltip="Name tags over players (N)" />
                    <ui:Button name="tool-aim" text="AIM" class="rv-tool" tooltip="Where each player is looking" />
                    <ui:Button name="tool-shots" text="SHOTS" class="rv-tool" tooltip="Shot tracers" />
                    <ui:Button name="tool-board" text="SCOREBOARD" class="rv-tool" tooltip="Keep the scoreboard open (hold Tab for a look)" />
                    <ui:Button name="tool-view" text="OVERVIEW" class="rv-tool" tooltip="Stop following and look at the whole map (Esc)" />
                    <ui:Button name="tool-bookmark" text="BOOKMARK" class="rv-tool" tooltip="Save this moment and view; open it from the replay library's Bookmarks (K)" />
                    <ui:Button name="tool-help" text="?" class="rv-tool rv-tool--help" tooltip="Shortcuts (F1)" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="timeline" class="rv-timeline">
                <ui:VisualElement class="rv-timeline-track" picking-mode="Ignore">
                    <ui:VisualElement name="timeline-fill" class="rv-timeline-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="timeline-marks" class="rv-timeline-marks" picking-mode="Ignore" />
                <ui:VisualElement name="timeline-head" class="rv-timeline-head" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="scoreboard" class="rv-scoreboard-overlay" picking-mode="Ignore" />

        <ui:VisualElement name="help-panel" class="rv-help">
            <ui:VisualElement class="rv-help-head">
                <ui:Label text="SHORTCUTS" class="rv-help-title" />
                <ui:Button name="help-close" text="CLOSE" class="rv-button rv-button--small" />
            </ui:VisualElement>
            <ui:VisualElement class="rv-help-columns">
                <ui:VisualElement class="rv-help-col">
                    <ui:Label text="PLAYBACK" class="rv-help-group" />
                    <ui:Label text="Space   play / pause" class="rv-help-line" />
                    <ui:Label text="Left / Right   5 s back / forward (Shift: 1 s)" class="rv-help-line" />
                    <ui:Label text="PgUp / PgDn   previous / next round" class="rv-help-line" />
                    <ui:Label text="- / +   slower / faster" class="rv-help-line" />
                    <ui:Label text="Tab (hold)   scoreboard" class="rv-help-line" />
                    <ui:Label text="CAMERA" class="rv-help-group" />
                    <ui:Label text="Right-drag   orbit   ·   left-drag   pan   ·   wheel   zoom" class="rv-help-line" />
                    <ui:Label text="WASD   move   ·   Q / E   rotate" class="rv-help-line" />
                    <ui:Label text="Click a player   follow   ·   Esc   stop following" class="rv-help-line" />
                    <ui:Label text="M   3D map / minimap   ·   N   name tags" class="rv-help-line" />
                    <ui:Label text="K   bookmark this moment" class="rv-help-line" />
                </ui:VisualElement>
                <ui:VisualElement class="rv-help-col">
                    <ui:Label text="MODES" class="rv-help-group" />
                    <ui:Label text="B   intel: cycle team (off, red, teal)" class="rv-help-line" />
                    <ui:Label text="H   hide what that team cannot know" class="rv-help-line" />
                    <ui:Label text="C   command mode on / off" class="rv-help-line" />
                    <ui:Label text="Enter   play as the followed player" class="rv-help-line" />
                    <ui:Label text="COMMAND MODE" class="rv-help-group" />
                    <ui:Label text="Left-click   select (Shift adds)   ·   Esc   clear" class="rv-help-line" />
                    <ui:Label text="Right-click the floor   move there" class="rv-help-line" />
                    <ui:Label text="F   plant / defuse / pick up the spike" class="rv-help-line" />
                    <ui:Label text="G   hold, facing the cursor   ·   X   back to the AI" class="rv-help-line" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
